# Text files are LF in the repository and in the working tree, on every machine. Without this, a Windows
# checkout with core.autocrlf=true can commit CRLF again (see #30). Git still detects binaries by content.
* text=auto eol=lf

# Binary files are never converted
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
